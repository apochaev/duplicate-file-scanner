{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "DFS server API",
    "version" : "1"
  },
  "servers" : [ {
    "url" : ""
  } ],
  "paths" : {
    "/api/scans" : {
      "get" : {
        "tags" : [ "scans" ],
        "summary" : "The scans of this server run, newest first",
        "operationId" : "listScans",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ScanEntry"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "scans" ],
        "summary" : "Start a scan of absolute folders",
        "operationId" : "startScan",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StartScanRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Started; Location names the scan",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScanEntry"
                }
              }
            }
          },
          "400" : {
            "description" : "Refused; nothing was started",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/cancel" : {
      "post" : {
        "tags" : [ "scans" ],
        "summary" : "Request that a scan stop",
        "operationId" : "cancelScan",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The scan after the request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScanEntry"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session" : {
      "get" : {
        "tags" : [ "session" ],
        "summary" : "Whether this browser holds a session",
        "operationId" : "getSession",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}" : {
      "get" : {
        "tags" : [ "scans" ],
        "summary" : "One scan and its progress",
        "operationId" : "getScan",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScanEntry"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/summaries" : {
      "get" : {
        "tags" : [ "overlaps" ],
        "summary" : "A page of a completed scan's folder summaries, ranked by bytes with a copy elsewhere; with under, those strictly inside it, plus under's own summary",
        "operationId" : "listSummaries",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "under",
          "in" : "query",
          "description" : "An absolute folder inside one of the scan's roots; without it, every summary",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "description" : "The page, from 0",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "description" : "Summaries per page, 1 to 500",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The page; past the end it has no items and the same total",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummaryPage"
                }
              }
            }
          },
          "400" : {
            "description" : "The path is not absolute (RELATIVE_PATH); or page below 0 or size outside 1 to 500 (INVALID_PAGE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403" : {
            "description" : "The path lies outside every root of the scan (PATH_OUTSIDE_ROOTS)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run (UNKNOWN_SCAN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409" : {
            "description" : "The scan is not COMPLETED (SCAN_NOT_COMPLETED)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/sets" : {
      "get" : {
        "tags" : [ "results" ],
        "summary" : "A page of a completed scan's duplicate sets with a path under the folder, largest reclaimable first, each with every copy",
        "operationId" : "listSets",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "under",
          "in" : "query",
          "description" : "An absolute folder inside one of the scan's roots; without it, every set",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "description" : "The page, from 0",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "description" : "Sets per page, 1 to 500",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The page; past the end it has no items and the same totals",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SetPage"
                }
              }
            }
          },
          "400" : {
            "description" : "The path is not absolute (RELATIVE_PATH); or page below 0 or size outside 1 to 500 (INVALID_PAGE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403" : {
            "description" : "The path lies outside every root of the scan (PATH_OUTSIDE_ROOTS)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run (UNKNOWN_SCAN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409" : {
            "description" : "The scan is not COMPLETED (SCAN_NOT_COMPLETED)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/pairs" : {
      "get" : {
        "tags" : [ "overlaps" ],
        "summary" : "A page of a completed scan's folder pairs, ranked by bytes with a copy; with under, those with at least one side inside it, whatever the other side",
        "operationId" : "listPairs",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "under",
          "in" : "query",
          "description" : "An absolute folder inside one of the scan's roots; without it, every pair",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "description" : "The page, from 0",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "description" : "Pairs per page, 1 to 500",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The page; past the end it has no items and the same total",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PairPage"
                }
              }
            }
          },
          "400" : {
            "description" : "The path is not absolute (RELATIVE_PATH); or page below 0 or size outside 1 to 500 (INVALID_PAGE)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403" : {
            "description" : "The path lies outside every root of the scan (PATH_OUTSIDE_ROOTS)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run (UNKNOWN_SCAN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409" : {
            "description" : "The scan is not COMPLETED (SCAN_NOT_COMPLETED)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/pair" : {
      "get" : {
        "tags" : [ "overlaps" ],
        "summary" : "The overlap of two folders inside a completed scan's roots, each counted recursively, a before b by path whatever order they were given in",
        "operationId" : "getPair",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "a",
          "in" : "query",
          "description" : "An absolute folder inside one of the scan's roots; required, checked by the server (MISSING_FOLDER)",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "b",
          "in" : "query",
          "description" : "Another absolute folder inside one of the scan's roots, neither equal to a nor containing or inside it; required, checked by the server (MISSING_FOLDER)",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The pair; a folder the scan holds nothing for is a side of zeros",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FolderPairView"
                }
              }
            }
          },
          "400" : {
            "description" : "a or b absent (MISSING_FOLDER); The path is not absolute (RELATIVE_PATH); or the folders are equal or one contains the other (NESTED_FOLDERS)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403" : {
            "description" : "The path lies outside every root of the scan (PATH_OUTSIDE_ROOTS)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run (UNKNOWN_SCAN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409" : {
            "description" : "The scan is not COMPLETED (SCAN_NOT_COMPLETED)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/folders" : {
      "get" : {
        "tags" : [ "results" ],
        "summary" : "A completed scan's roots, or the immediate subfolders of parent that hold counted files, ordered by name, with subtree and direct totals",
        "operationId" : "listFolders",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "parent",
          "in" : "query",
          "description" : "An absolute folder inside one of the scan's roots; without it, the roots",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "One level of the tree; empty when the scan holds nothing there",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/FolderNode"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "The path is not absolute (RELATIVE_PATH)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403" : {
            "description" : "The path lies outside every root of the scan (PATH_OUTSIDE_ROOTS)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run (UNKNOWN_SCAN)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409" : {
            "description" : "The scan is not COMPLETED (SCAN_NOT_COMPLETED)",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{id}/events" : {
      "get" : {
        "tags" : [ "scans" ],
        "summary" : "Server-Sent Events: a progress event with a ScanProgress at most every 250 ms, ending with the terminal status",
        "operationId" : "streamScanEvents",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "text/event-stream" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScanProgress"
                }
              }
            }
          },
          "404" : {
            "description" : "No such scan in this server run",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "StartScanRequest" : {
        "type" : "object",
        "properties" : {
          "locations" : {
            "type" : "array",
            "description" : "Absolute paths of the folders to scan",
            "items" : {
              "type" : "string"
            }
          },
          "minSize" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Files smaller than this many bytes are left out; at least 1 (default 1)"
          },
          "defaultExcludes" : {
            "type" : "boolean",
            "description" : "Leave out .DS_Store and ._* files (default true)"
          }
        },
        "required" : [ "locations" ]
      },
      "ScanEntry" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "locations" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "progress" : {
            "$ref" : "#/components/schemas/ScanProgress"
          }
        },
        "required" : [ "id", "locations", "progress", "startedAt" ]
      },
      "ScanProgress" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "QUEUED", "RUNNING", "CANCELLING", "COMPLETED", "CANCELLED", "FAILED" ]
          },
          "phase" : {
            "type" : [ "string", "null" ],
            "enum" : [ "WALK", "PARTIAL_HASH", "FULL_HASH", "HARD_LINKS" ]
          },
          "directories" : {
            "type" : "integer",
            "format" : "int64"
          },
          "files" : {
            "type" : "integer",
            "format" : "int64"
          },
          "bytes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "hashedFiles" : {
            "type" : "integer",
            "format" : "int64"
          },
          "hashFilesTotal" : {
            "type" : "integer",
            "format" : "int64"
          },
          "hashedBytes" : {
            "type" : "integer",
            "format" : "int64"
          },
          "hashBytesTotal" : {
            "type" : "integer",
            "format" : "int64"
          },
          "groupsDone" : {
            "type" : "integer",
            "format" : "int32"
          },
          "groupsTotal" : {
            "type" : "integer",
            "format" : "int32"
          },
          "failureMessage" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "bytes", "directories", "files", "groupsDone", "groupsTotal", "hashBytesTotal", "hashFilesTotal", "hashedBytes", "hashedFiles", "status" ]
      },
      "ApiError" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "message" ]
      },
      "SessionStatus" : {
        "type" : "object",
        "properties" : {
          "authenticated" : {
            "type" : "boolean"
          }
        },
        "required" : [ "authenticated" ]
      },
      "FolderSummaryView" : {
        "type" : "object",
        "properties" : {
          "folder" : {
            "type" : "string",
            "description" : "The folder's path as the scan holds it (Path.toString(): backslashes on Windows)"
          },
          "totalFiles" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Counted files in the whole subtree"
          },
          "totalBytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Their summed size in bytes"
          },
          "filesWithCopyElsewhere" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Files in the subtree with a different physical copy of their content outside the subtree; each file counts once"
          },
          "bytesWithCopyElsewhere" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Their summed size in bytes"
          },
          "internalDuplicateFiles" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "For each content with k >= 2 physical copies inside the subtree, k - 1"
          },
          "internalBytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "For each such content, (k - 1) x size"
          }
        },
        "required" : [ "bytesWithCopyElsewhere", "filesWithCopyElsewhere", "folder", "internalBytes", "internalDuplicateFiles", "totalBytes", "totalFiles" ]
      },
      "SummaryPage" : {
        "type" : "object",
        "properties" : {
          "folder" : {
            "type" : "null",
            "$ref" : "#/components/schemas/FolderSummaryView",
            "description" : "The summary of the folder given as under; null without under"
          },
          "items" : {
            "type" : "array",
            "description" : "Ordered by bytesWithCopyElsewhere, then internalBytes, largest first, then folder path",
            "items" : {
              "$ref" : "#/components/schemas/FolderSummaryView"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The page asked for, from 0"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The page size asked for, 1 to 500"
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Every matching summary"
          }
        },
        "required" : [ "items", "page", "size", "totalItems" ]
      },
      "CopyView" : {
        "type" : "object",
        "properties" : {
          "links" : {
            "type" : "array",
            "description" : "At least one; ordered by path",
            "items" : {
              "$ref" : "#/components/schemas/LinkView"
            }
          }
        },
        "required" : [ "links" ]
      },
      "DuplicateSetView" : {
        "type" : "object",
        "properties" : {
          "digest" : {
            "type" : "string",
            "description" : "Lowercase hexadecimal SHA-256 of the content; identifies the set"
          },
          "size" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Size of each file in bytes"
          },
          "reclaimableBytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "size * (physical copies - 1): hard links are not reclaimable copies"
          },
          "copies" : {
            "type" : "array",
            "description" : "At least two; ordered by first link path",
            "items" : {
              "$ref" : "#/components/schemas/CopyView"
            }
          }
        },
        "required" : [ "copies", "digest", "reclaimableBytes", "size" ]
      },
      "LinkView" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string",
            "description" : "The path as the scan holds it (Path.toString(): backslashes on Windows)"
          },
          "modified" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "The file's modified time at scan time"
          }
        },
        "required" : [ "modified", "path" ]
      },
      "SetPage" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "description" : "Ordered by reclaimableBytes, then size, largest first, then digest",
            "items" : {
              "$ref" : "#/components/schemas/DuplicateSetView"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The page asked for, from 0"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The page size asked for, 1 to 500"
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Every matching set"
          },
          "totalReclaimableBytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The reclaimable bytes of every matching set"
          }
        },
        "required" : [ "items", "page", "size", "totalItems", "totalReclaimableBytes" ]
      },
      "FolderPairView" : {
        "type" : "object",
        "properties" : {
          "a" : {
            "$ref" : "#/components/schemas/PairSideView",
            "description" : "The side whose folder sorts first"
          },
          "b" : {
            "$ref" : "#/components/schemas/PairSideView",
            "description" : "The side whose folder sorts second"
          }
        },
        "required" : [ "a", "b" ]
      },
      "PairPage" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "description" : "Ordered by the larger bytesWithCopy of the two sides, largest first, then a's folder, then b's folder",
            "items" : {
              "$ref" : "#/components/schemas/FolderPairView"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The page asked for, from 0"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "The page size asked for, 1 to 500"
          },
          "totalItems" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Every matching pair"
          }
        },
        "required" : [ "items", "page", "size", "totalItems" ]
      },
      "PairSideView" : {
        "type" : "object",
        "properties" : {
          "folder" : {
            "type" : "string",
            "description" : "This side's folder (Path.toString(): backslashes on Windows)"
          },
          "filesWithCopy" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Its files with a different physical copy of their content in the other folder; hard links never count"
          },
          "totalFiles" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Its counted files"
          },
          "bytesWithCopy" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The summed size of filesWithCopy"
          },
          "totalBytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "The summed size of totalFiles"
          },
          "full" : {
            "type" : "boolean",
            "description" : "True exactly when this side has at least one file and every one of them has a copy in the other folder"
          }
        },
        "required" : [ "bytesWithCopy", "filesWithCopy", "folder", "full", "totalBytes", "totalFiles" ]
      },
      "FolderNode" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string",
            "description" : "The folder's path as the scan holds it (Path.toString(): backslashes on Windows)"
          },
          "name" : {
            "type" : "string",
            "description" : "The last name element; for a filesystem root such as C:\\ the whole path"
          },
          "files" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Counted files in the whole subtree"
          },
          "bytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Their summed size in bytes"
          },
          "directFiles" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Counted files directly in this folder"
          },
          "directBytes" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Their summed size in bytes"
          },
          "hasChildren" : {
            "type" : "boolean",
            "description" : "Whether listFolders with this folder as parent answers at least one folder"
          }
        },
        "required" : [ "bytes", "directBytes", "directFiles", "files", "hasChildren", "name", "path" ]
      }
    }
  }
}
