{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate-api": "ng-openapi-gen --input openapi.json --output src/app/api --services true",
    "prestart": "npm run generate-api",
    "start": "ng serve",
    "prebuild": "npm run generate-api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run generate-api",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "jsdom": "30.1.3",
    "ng-openapi-gen": "1.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
